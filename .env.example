# Copy to .env and fill in. All VITE_* values are inlined into the client bundle
# at build time, so NEVER put a secret here. The Gemini API key deliberately does
# not appear below: Firebase AI Logic provisions and holds it server-side, and the
# browser reaches Gemini through that proxy.

# --- Firebase project (safe to expose; these identify the project, they don't
# --- authorise anything on their own) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- App Check ---
# Required for recipe generation. Firebase AI Logic enforces App Check, so without
# this the Gemini proxy rejects requests. This is the reCAPTCHA v3 *site* key,
# which is public by design.
VITE_RECAPTCHA_SITE_KEY=

# Local development only. App Check enforcement blocks localhost unless you
# register a debug token: run the app, copy the token the SDK logs to the console,
# and register it under App Check > Apps > Manage debug tokens. Leave blank to let
# the SDK generate a fresh one each run.
VITE_APPCHECK_DEBUG_TOKEN=

# Local dev only: route Auth and Firestore at the emulator suite instead of the
# live project. Needed to test features whose writes cannot be undone (a
# suggestion is `allow delete: if false`, so a test one would be permanent).
# Start the suite with `npm run emulators`, then `VITE_USE_EMULATORS=true npm run dev`.
VITE_USE_EMULATORS=false

# --- Google sign-in (optional) ---
# `true` shows "Continue with Google" (RL-188). Not a secret. Leave unset until
# RL-191 enables the Google provider in the Firebase console, or the button fails
# live. The Auth emulator accepts Google with fake accounts.
VITE_ENABLE_GOOGLE_SIGNIN=

# --- Analytics (optional) ---
# PostHog public project key and ingestion host. Leave unset and the consent
# banner and the Settings privacy toggle do not appear (RL-052, RL-054).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# --- Operator only, not read by the app ---
# scripts/data-request.mjs ignores GCLOUD_PROJECT. Name the project with --project
# (docs/operations.md, "Data requests").
