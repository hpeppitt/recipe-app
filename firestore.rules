rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Anyone who has proved they own an email address.
    //
    // This is the line between consuming the app and contributing to it.
    // Anonymous sign-in is one tap and costs nothing, so `signedIn()` alone is
    // not a meaningful barrier to anyone who wants to put a recipe in front of
    // everybody else. Owning an inbox is a small barrier, but it is a real one,
    // and it gives a misbehaving account a name that survives a page refresh.
    //
    // Reading, favouriting and following deliberately stay open to anonymous
    // users: none of them add content anyone else has to look at.
    //
    // The claim rides the ID token. That would normally mean it lags
    // verification by up to an hour, but both of this app's routes to a
    // verified email (`linkWithCredential` on an anonymous account, and
    // `signInWithEmailLink`) mint a fresh token as part of the call, so the
    // claim is present the instant the user is verified. Checked against the
    // Auth emulator 2026-08-10: both paths report email_verified == true on the
    // cached token, with no forced refresh.
    //
    // This would stop being true if a path ever verified an email out of band,
    // e.g. sendEmailVerification with the user clicking through in another tab.
    // Such a path would need getIdToken(true) before its first write.
    // `.get` with a default rather than `request.auth.token.email_verified`.
    // An anonymous token has no such property at all, and reading a missing
    // property raises an evaluation error instead of returning false. That
    // denies correctly here, so both forms behave identically today, but an
    // error propagates through a disjunction: the moment anyone writes
    // `allow x: if isSomethingElse() || verified()`, the error form would take
    // down the whole expression for anonymous users rather than falling through
    // to the branch that should have allowed it. Verified against the emulator:
    // the property form logs "Property email_verified is undefined on object".
    function verified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Recipes: public feed, owner-controlled writes ---
    match /recipes/{recipeId} {
      // Library feed and shared pages are browsable without signing in
      allow read: if true;

      // Publish: must have a verified email, must stamp yourself as creator,
      // counters must start at zero
      allow create: if verified()
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.favoriteCount == 0
        && request.resource.data.viewCount == 0;

      allow update: if isViewIncrement()
        || isFavoriteCountBump()
        || isOwnerUpdate();

      allow delete: if signedIn()
        && resource.data.createdBy.uid == request.auth.uid;

      // Anyone (including signed-out visitors) may bump viewCount by
      // exactly 1 and touch nothing else
      function isViewIncrement() {
        return changedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.viewCount + 1;
      }

      // Favorite/unfavorite batch from any signed-in user: favoriteCount
      // moves by exactly +/-1 and nothing else changes
      function isFavoriteCountBump() {
        return signedIn()
          && changedKeys().hasOnly(['favoriteCount'])
          && (request.resource.data.favoriteCount == resource.data.favoriteCount + 1
              || request.resource.data.favoriteCount == resource.data.favoriteCount - 1);
      }

      // Owner may edit their recipe (e.g. collaborators arrayUnion on
      // suggestion approval) but can never reassign ownership.
      //
      // Deliberately `signedIn()` and not `verified()`, unlike create. Recipes
      // published anonymously before the verified-email gate went in are still
      // owned by an anonymous account, and requiring verification here would
      // leave that owner able to delete their recipe but not correct a typo in
      // it. Nothing new reaches the library through this path: it can only edit
      // a document that already passed the create rule.
      function isOwnerUpdate() {
        return signedIn()
          && resource.data.createdBy.uid == request.auth.uid
          && request.resource.data.createdBy.uid == resource.data.createdBy.uid;
      }
    }

    // --- Favorites: doc id is {uid}_{recipeId}, owned by the favoriting user ---
    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.recipeId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // --- Suggestions: anyone signed in may suggest; only the recipe owner reviews ---
    match /suggestions/{suggestionId} {
      // Read is any-signed-in because the client subscribes by recipeId only;
      // tighten to owner/suggester if the query adds a recipeOwnerId filter
      allow read: if signedIn();
      // Suggesting puts text in front of another user, so it takes a verified
      // email for the same reason publishing does.
      allow create: if verified()
        && request.resource.data.suggestedBy.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && resource.data.recipeOwnerId == request.auth.uid
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;

      // --- Reply thread on a suggestion ---
      // A subcollection rather than a `replies` array on the parent, so the
      // owner-only + status-only update rule above stays intact. Relaxing that
      // rule to permit an array append would also permit rewriting the
      // suggestion body, which is a wider grant than replying needs.
      //
      // Writable by the two participants only, and only for a message stamped
      // with the writer's own uid. Immutable once sent, like notifications:
      // there is no edit or delete UI, and allowing either would let one party
      // silently rewrite a thread the other has already read.
      //
      // Replies stay allowed after approval or rejection on purpose. A
      // rejection is exactly when the suggester wants to ask why, so gating on
      // status == 'pending' would close the conversation at the moment it
      // becomes most useful.
      //
      // Each get() bills one document read, so sending a reply costs 2 reads.
      match /messages/{messageId} {
        allow read: if signedIn();
        // Both participants reached this thread through a verified-email action
        // (publishing the recipe, or filing the suggestion), so requiring it
        // again here costs nothing and keeps the rule honest on its own terms
        // rather than depending on how the thread was reached.
        allow create: if verified()
          && request.resource.data.fromUid == request.auth.uid
          && (
            get(/databases/$(database)/documents/suggestions/$(suggestionId)).data.recipeOwnerId == request.auth.uid
            || get(/databases/$(database)/documents/suggestions/$(suggestionId)).data.suggestedBy.uid == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    // --- Notifications: written by the acting user, readable by the recipient ---
    //
    // Create stays `signedIn()` and must not be raised to `verified()`. Both
    // `addCloudFavorite` and `followUser` write a notification as part of the
    // action, and favouriting and following are two of the three things an
    // anonymous user is still meant to be able to do. Gating this would fail
    // those writes for exactly the users the verified-email split keeps
    // deliberately open, and the failure would surface as a broken favourite
    // rather than as anything mentioning notifications.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.read == false;
      // Recipient may only flip the read flag
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && changedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // --- Profiles: public read; own doc writable; others may only bump followerCount ---
    match /profiles/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && (request.auth.uid == uid || isFollowerCountBump());
      allow delete: if signedIn() && request.auth.uid == uid;

      function isFollowerCountBump() {
        return changedKeys().hasOnly(['followerCount'])
          && (request.resource.data.followerCount == resource.data.followerCount + 1
              || request.resource.data.followerCount == resource.data.followerCount - 1);
      }
    }

    // --- Client error reports: write-only drop box ---
    //
    // Create-only, by anyone including signed-out visitors, because a failure that
    // happens before or during sign-in is exactly the kind currently invisible.
    //
    // No read, ever, from a client. These documents carry stack traces and uids;
    // the only consumer is you, in the console. No update or delete either, so a
    // report cannot be altered after the fact.
    //
    // The field constraints are the abuse control. This is an unauthenticated
    // write path, so it is bounded in shape rather than left open: required keys
    // must be present and correctly typed, nothing outside the known set is
    // accepted, and the two free-text fields are length-capped so the collection
    // cannot be used as free storage. The client caps sends per session as well,
    // but a client-side cap protects Firestore costs from *bugs*, not from people.
    match /clientErrors/{reportId} {
      allow read, update, delete: if false;
      allow create: if isWellFormedReport();

      function isWellFormedReport() {
        let d = request.resource.data;
        return d.keys().hasOnly([
              'source', 'message', 'stack', 'route', 'context',
              'at', 'uid', 'receivedAt', 'userAgent'
            ])
          && d.keys().hasAll(['source', 'message', 'route', 'at'])
          && d.source in ['window.onerror', 'unhandledrejection', 'handled']
          && d.message is string && d.message.size() <= 600
          && d.route is string && d.route.size() <= 250
          && (!('stack' in d.keys()) || d.stack == null || (d.stack is string && d.stack.size() <= 2200))
          && (!('context' in d.keys()) || d.context == null || (d.context is string && d.context.size() <= 150))
          && (!('userAgent' in d.keys()) || (d.userAgent is string && d.userAgent.size() <= 350))
          && d.at is int
          // Either signed out, or stamped with the writer's own uid. Nobody gets
          // to file reports against someone else's account.
          && (!('uid' in d.keys()) || d.uid == null || d.uid == request.auth.uid);
      }
    }

    // --- Rate limits: server-only ---
    // Written exclusively by the generateRecipe Cloud Function via the Admin SDK,
    // which bypasses these rules. Denying everything to clients is what stops a
    // user resetting their own quota, so this must stay closed.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // --- Follows: doc id is {followerId}_{followingId}, controlled by the follower ---
    match /follows/{followId} {
      allow read: if signedIn()
        && (resource.data.followerId == request.auth.uid
            || resource.data.followingId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
  }
}
