rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Anyone who has proved they own an email address.
    //
    // Every client cloud write requires this, except a recipe view increment
    // and a clientErrors report (see each for why). Product decision of
    // 2026-10-14 (docs/decisions.md, superseding product decision 1): anonymous
    // accounts hold local bookmarks only, so favouriting, following,
    // notifications, profile writes and every owner edit or delete need a
    // verified email. Reads are not covered by the decision and are unchanged.
    // Anonymous sign-in is one tap and costs nothing; owning an inbox is a small
    // barrier, but it is a real one.
    //
    // The claim rides the ID token. That would normally mean it lags
    // verification by up to an hour, but both of this app's routes to a
    // verified email (`linkWithCredential` on an anonymous account, and
    // `signInWithEmailLink`) mint a fresh token as part of the call, so the
    // claim is present the instant the user is verified. Checked against the
    // Auth emulator 2026-08-10: both paths report email_verified == true on the
    // cached token, with no forced refresh.
    //
    // This would stop being true if a path ever verified an email out of band,
    // e.g. sendEmailVerification with the user clicking through in another tab.
    // Such a path would need getIdToken(true) before its first write.
    // `.get` with a default rather than `request.auth.token.email_verified`.
    // An anonymous token has no such property at all, and reading a missing
    // property raises an evaluation error instead of returning false. That
    // denies correctly here, so both forms behave identically today, but an
    // error propagates through a disjunction: the moment anyone writes
    // `allow x: if isSomethingElse() || verified()`, the error form would take
    // down the whole expression for anonymous users rather than falling through
    // to the branch that should have allowed it. Verified against the emulator:
    // the property form logs "Property email_verified is undefined on object".
    function verified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    // --- Terms acceptance (RL-047) ---
    //
    // The version a contributor must have accepted. MUST equal TERMS_VERSION in
    // src/lib/legal.ts; src/lib/legal.test.ts fails the build when they differ.
    // Bump both together, and deploy these rules in the order docs/operations.md
    // gives: a bump denies every contributing write until the user re-accepts.
    function termsVersion() {
      return '2026-10-17';
    }

    // Guards the content-creating writes only: recipe create, suggestion create
    // and message create. exists() first, so a missing document denies as a plain
    // false rather than an evaluation error. The exists() and get() of the same
    // path bill one document read per guarded write, and count toward the
    // per-request limit on document accesses (10 for a single write, 20 for a
    // batch), alongside the suggestion rules' own get()s.
    function acceptedTerms() {
      let path = /databases/$(database)/documents/termsAcceptance/$(request.auth.uid);
      return verified() && exists(path) && get(path).data.version == termsVersion();
    }

    // --- Write limits (RL-048, RL-049) ---
    //
    // MUST equal RATE_LIMITS in src/lib/rateLimit.ts (SUGGESTION_CAP, REPLY_CAP,
    // NOTIFICATION_CAP, RECIPE_CAP, WINDOW_MS, RECIPE_WINDOW_MS);
    // src/lib/rateLimit.test.ts fails the build when they differ:
    //   suggestions  10 per hour
    //   replies      30 per hour
    //   notifications 60 per hour
    //   recipes      30 per day (creates only; a re-publish is an update)
    //   window       3600000 ms
    //   recipe window 86400000 ms
    function suggestionCap() {
      return 10;
    }
    function replyCap() {
      return 30;
    }
    function notificationCap() {
      return 60;
    }
    function recipeCap() {
      return 30;
    }
    function windowMs() {
      return 3600000;
    }
    function recipeWindowMs() {
      return 86400000;
    }

    // Per-action cap and window length. Only called with an action from
    // ownWindowIds(), so the map lookup never misses.
    function capFor(action) {
      return {'suggestion': suggestionCap(), 'reply': replyCap(), 'notification': notificationCap(), 'recipe': recipeCap()}[action];
    }
    function windowMsFor(action) {
      return {'suggestion': windowMs(), 'reply': windowMs(), 'notification': windowMs(), 'recipe': recipeWindowMs()}[action];
    }

    // Proves the limited create moved writeWindows/{uid}_{action} in the same
    // request (the client writes both in one transaction) AND that this bump
    // names this document: the window holds one `last` value after the request,
    // so one bump admits exactly one create. Without `last`, one bump in a batch
    // admitted any number of creates (emulator-checked before the fix).
    // existsAfter() first, so a missing window denies as a plain false. Adds one
    // document access (and one billed read) per guarded create.
    function movedWindow(action, docPath) {
      let path = /databases/$(database)/documents/writeWindows/$(request.auth.uid + '_' + action);
      return existsAfter(path)
        && getAfter(path).data.at == request.time
        && getAfter(path).data.last == docPath;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Recipes: public feed, owner-controlled writes ---
    //
    // Size and time bounds (RL-016). Named here so RL-036 can mirror them on
    // the client; the rules language has no constants, so the literals below
    // must match:
    //   MAX_TITLE_LENGTH        = 200    characters (UTF-16 units)
    //   MAX_INGREDIENTS         = 100    list entries
    //   MAX_INSTRUCTIONS        = 100    list entries
    //   CREATED_AT_MAX_SKEW_MS  = 60000  how far ahead of server time a create
    //                                    may stamp createdAt
    // The feed is orderBy('createdAt', 'desc'), so an unbounded createdAt pins a
    // recipe to the top of everyone's feed forever, and an oversized document is
    // read on every first paint. Past values stay allowed: imports keep their
    // original createdAt. Elements inside the arrays are not checked; rules
    // cannot iterate a list.
    match /recipes/{recipeId} {
      // Library feed and shared pages are browsable without signing in
      allow read: if true;

      // Publish: must have a verified email, must stamp yourself as creator,
      // counters must start at zero
      allow create: if verified()
        && acceptedTerms()
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.favoriteCount == 0
        && request.resource.data.viewCount == 0
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 60000
        && hasBoundedContent()
        && movedWindow('recipe', 'recipes/' + recipeId);

      // Not limited: a re-publish, view or favourite bump is an update and
      // needs no window (RL-049 limits creates only).
      allow update: if isViewIncrement()
        || isFavoriteCountBump()
        || isOwnerUpdate()
        || isReparentAfterParentDelete();

      allow delete: if verified()
        && resource.data.createdBy.uid == request.auth.uid;

      // Anyone (including signed-out visitors) may bump viewCount by
      // exactly 1 and touch nothing else. Exempt from the verified-email rule
      // of 2026-10-14 on purpose: a view is an implicit page-view metric the
      // app records on open, not a user action.
      function isViewIncrement() {
        return changedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.viewCount + 1;
      }

      // Favorite/unfavorite batch from a verified user: favoriteCount
      // moves by exactly +/-1 and nothing else changes
      function isFavoriteCountBump() {
        return verified()
          && changedKeys().hasOnly(['favoriteCount'])
          && (request.resource.data.favoriteCount == resource.data.favoriteCount + 1
              || request.resource.data.favoriteCount == resource.data.favoriteCount - 1);
      }

      // Owner may edit their recipe (e.g. collaborators arrayUnion on
      // suggestion approval) but can never reassign ownership or move
      // createdAt (re-publish merges the same value, so it is not a changed key).
      //
      // `verified()`, like create and delete, per the 2026-10-14 decision.
      // This used to stay `signedIn()` so owners of recipes published
      // anonymously before the 2026-08-10 gate could still edit them; RL-042
      // wipes that pre-gate data, so the exception has nothing left to protect.
      function isOwnerUpdate() {
        return verified()
          && resource.data.createdBy.uid == request.auth.uid
          && request.resource.data.createdBy.uid == resource.data.createdBy.uid
          && !('createdAt' in changedKeys())
          && hasBoundedContent();
      }

      // RL-158: deleting a version P moves its direct children up to P's parent
      // in the same batch, including children by other cooks. Only P's owner,
      // only while P is deleted in this request (get() sees the stored P,
      // existsAfter() the state after the batch), only to P's own parent (so
      // never for an original), and only parentId and depth, one level up.
      // Content is unchanged, so hasBoundedContent() is not needed. The new
      // parent must exist, since P's owner controls P.parentId (accepted risk:
      // docs/decisions.md, RL-158). Deeper descendants keep their stored depth.
      // Accesses: P and the new parent, once per batch; isMovedNotice() adds
      // each other cook's child. MAX_MOVED_CHILDREN in src/lib/tree.ts caps the
      // children per batch; re-probe it after changing either rule.
      function isReparentAfterParentDelete() {
        let oldParent = resource.data.get('parentId', null);
        return verified()
          && changedKeys().hasOnly(['parentId', 'depth'])
          && oldParent is string
          && isDeletedParentOf(/databases/$(database)/documents/recipes/$(oldParent))
          // A missing or non-integer stored depth may become 0, so one malformed
          // child cannot make its parent undeletable (RL-159).
          && (resource.data.get('depth', null) is int
            ? request.resource.data.depth == resource.data.depth - 1
            : request.resource.data.depth == 0);
      }

      function isDeletedParentOf(path) {
        return get(path).data.createdBy.uid == request.auth.uid
          && !existsAfter(path)
          && get(path).data.get('parentId', null) is string
          && request.resource.data.parentId == get(path).data.parentId
          && exists(/databases/$(database)/documents/recipes/$(get(path).data.parentId));
      }

      // Evaluated on request.resource.data, the document as it would be after
      // the write, so an update that omits these fields (a merge, or the
      // collaborators arrayUnion) is checked against the stored values.
      function hasBoundedContent() {
        let d = request.resource.data;
        return d.title is string && d.title.size() <= 200
          && d.ingredients is list && d.ingredients.size() <= 100
          && d.instructions is list && d.instructions.size() <= 100
          // RL-162: a recipe id (a UUID); absent or null on most recipes.
          && (d.get('relatedFamilyId', null) == null
            || (d.relatedFamilyId is string && d.relatedFamilyId.size() <= 128))
          // RL-172: credited uids for array-contains; absent on older recipes.
          && (!('collaboratorUids' in d)
            || (d.collaboratorUids is list && d.collaboratorUids.size() <= 50));
      }
    }

    // --- Favorites: doc id is {uid}_{recipeId}, owned by the favoriting user ---
    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if verified()
        && request.resource.data.uid == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.recipeId;
      allow delete: if verified() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // --- Suggestions: verified users may suggest; only the recipe owner reviews ---
    match /suggestions/{suggestionId} {
      // Two parties only (RL-018): the recipe owner and the suggester. Anonymous
      // accounts read none, per the 2026-10-14 decision. A list is authorised
      // from its filters, so the client must filter on recipeOwnerId (owner) or
      // suggestedBy.uid (everyone else) equal to its own uid; an unfiltered
      // query by recipeId is denied whole.
      allow read: if verified()
        && (resource.data.recipeOwnerId == request.auth.uid
            || resource.data.suggestedBy.uid == request.auth.uid);
      // Suggesting puts text in front of another user, so it takes a verified
      // email for the same reason publishing does.
      //
      // recipeOwnerId must name the real owner (one extra read per create): a
      // wrong value leaves a suggestion no one can review and, since delete is
      // forbidden, no one can remove.
      //
      // A fixed key set (RL-146): the fields createSuggestion writes plus
      // `edits`. Without it a suggester could pre-set `branchId`, which the
      // owner's Decline and Apply may not touch, or any other field.
      allow create: if verified()
        && acceptedTerms()
        && request.resource.data.suggestedBy.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['recipeId', 'recipeOwnerId', 'recipeTitle', 'recipeEmoji', 'suggestedBy', 'message', 'status', 'createdAt', 'edits'])
        && validEdits(request.resource.data)
        && get(/databases/$(database)/documents/recipes/$(request.resource.data.recipeId)).data.createdBy.uid == request.resource.data.recipeOwnerId
        && movedWindow('suggestion', 'suggestions/' + suggestionId);
      // The owner closes an open suggestion exactly once (RL-146): Declined
      // ('rejected'), Applied, or Branched with the id of the branch Keep as
      // branch created. 'approved' is no longer writable; old approved
      // documents stay as they are. A closed suggestion cannot change.
      allow update: if verified()
        && resource.data.recipeOwnerId == request.auth.uid
        && resource.data.status == 'pending'
        && changedKeys().hasOnly(['status', 'branchId'])
        && (
          (request.resource.data.status in ['rejected', 'applied']
            && !('branchId' in changedKeys()))
          || (request.resource.data.status == 'branched'
            && request.resource.data.branchId is string
            && isOwnBranchOf(request.resource.data.branchId, resource.data.recipeId))
        );
      allow delete: if false;

      // The branch must be the owner's own child of the suggested recipe. The
      // exists() and get() of one path count as one document read.
      function isOwnBranchOf(branchId, recipeId) {
        let path = /databases/$(database)/documents/recipes/$(branchId);
        return exists(path)
          && get(path).data.parentId == recipeId
          && get(path).data.createdBy.uid == request.auth.uid;
      }

      // Structured edits (RL-145, RL-146). Optional: a free-text suggestion has
      // none. Rules cannot loop over a list, so the count is capped and each
      // index is checked explicitly. MUST equal MAX_EDITS and the MAX_EDIT_*
      // caps in src/lib/suggestion.ts; src/lib/suggestion.test.ts fails the
      // build when they differ:
      //   edits        10 per suggestion
      //   from         1000 characters
      //   to           1000 characters
      //   index        99 at most
      //   name         200 characters
      //   why          200 characters
      // RE2 caps a repeat count at 1000, so no cap here may exceed 1000.
      //
      // Text fields are checked with matches() rather than `is string` plus
      // size(). A request may evaluate at most 1000 expressions, shared with the
      // writeWindows write in the same transaction; with size() the emulator
      // denied 7 full edits for that reason alone, with matches() 10 pass
      // (RL-146 Notes). matches() errors on a non-string, which denies, and
      // counts code points where size() counts UTF-16 units, so text in astral
      // characters (emoji) may run to twice the cap in UTF-16 units. The client
      // caps by UTF-16 length, which is never longer in code points, so a
      // client write is never denied by the difference. Adding checks here can
      // push 10 edits back over the limit: re-probe 10 full edits after any change.
      function validEdits(d) {
        return !('edits' in d) || validEditList(d.edits);
      }

      function validEditList(es) {
        let n = es.size();
        return es is list && n >= 1 && n <= 10
          && (n <= 0 || validEdit(es[0]))
          && (n <= 1 || validEdit(es[1]))
          && (n <= 2 || validEdit(es[2]))
          && (n <= 3 || validEdit(es[3]))
          && (n <= 4 || validEdit(es[4]))
          && (n <= 5 || validEdit(es[5]))
          && (n <= 6 || validEdit(es[6]))
          && (n <= 7 || validEdit(es[7]))
          && (n <= 8 || validEdit(es[8]))
          && (n <= 9 || validEdit(es[9]));
      }

      function validEdit(e) {
        let i = e.get('index', 0);
        return e.keys().hasOnly(['kind', 'index', 'name', 'from', 'to', 'why'])
          && e.kind in ['ingredient', 'step', 'general']
          && e.from.matches('(?s).{0,1000}')
          && e.to.matches('(?s).{1,1000}')
          && i is int && i >= 0 && i <= 99
          && e.get('name', '').matches('(?s).{0,200}')
          && e.get('why', '').matches('(?s).{0,200}');
      }

      // --- Reply thread on a suggestion ---
      // A subcollection rather than a `replies` array on the parent, so the
      // owner-only update rule above stays narrow. Relaxing that
      // rule to permit an array append would also permit rewriting the
      // suggestion body, which is a wider grant than replying needs.
      //
      // Writable by the two participants only, and only for a message stamped
      // with the writer's own uid. Immutable once sent, like notifications:
      // there is no edit or delete UI, and allowing either would let one party
      // silently rewrite a thread the other has already read.
      //
      // Replies stay allowed after the suggestion is closed on purpose. A
      // rejection is exactly when the suggester wants to ask why, so gating on
      // status == 'pending' would close the conversation at the moment it
      // becomes most useful.
      //
      // Each get() bills one document read, so sending a reply costs 2 reads
      // (plus the writeWindows read in the client's transaction and the
      // getAfter() in movedWindow(), RL-048) and opening a thread costs one read
      // on top of its messages.
      match /messages/{messageId} {
        // Same two parties as the parent's read rule. The parent is fetched by
        // path, so this holds for a list without any filter on the messages.
        allow read: if verified()
          && (
            get(/databases/$(database)/documents/suggestions/$(suggestionId)).data.recipeOwnerId == request.auth.uid
            || get(/databases/$(database)/documents/suggestions/$(suggestionId)).data.suggestedBy.uid == request.auth.uid
          );
        // Both participants reached this thread through a verified-email action
        // (publishing the recipe, or filing the suggestion), so requiring it
        // again here costs nothing and keeps the rule honest on its own terms
        // rather than depending on how the thread was reached.
        allow create: if verified()
          && acceptedTerms()
          && request.resource.data.fromUid == request.auth.uid
          && (
            get(/databases/$(database)/documents/suggestions/$(suggestionId)).data.recipeOwnerId == request.auth.uid
            || get(/databases/$(database)/documents/suggestions/$(suggestionId)).data.suggestedBy.uid == request.auth.uid
          )
          && movedWindow('reply', 'suggestions/' + suggestionId + '/messages/' + messageId);
        allow update, delete: if false;
      }
    }

    // --- Notifications: written by the acting user, readable by the recipient ---
    //
    // Create, mark-read and delete all take `verified()`, per the 2026-10-14
    // decision. This used to stay `signedIn()` because favouriting and following
    // (which write a notification as part of the action) were open to anonymous
    // accounts; both now need a verified email too, so the reason is gone.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      // Shape checks (RL-015): a fixed key set, a known type, and a message that
      // is null for favourite and follow and at most 500 characters otherwise.
      // size() counts UTF-16 units (emulator: 250 emoji pass, 251 are denied).
      // hasOnly permits absent keys, which `follow` relies on: it has no recipe
      // fields. The client truncates text to fit (src/lib/notifications.ts),
      // because these writes are fire-and-forget and a denial is silent.
      allow create: if verified()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['recipientUid', 'type', 'recipeId', 'recipeTitle', 'recipeEmoji', 'fromUid', 'fromDisplayName', 'message', 'read', 'createdAt'])
        && (
          ((
            (request.resource.data.type in ['favorite', 'follow']
              && request.resource.data.get('message', null) == null)
            || (request.resource.data.type in ['suggestion', 'suggestion_reply', 'suggestion_approved', 'suggestion_rejected', 'suggestion_applied', 'suggestion_branched']
              && (request.resource.data.get('message', null) == null
                || (request.resource.data.message is string && request.resource.data.message.size() <= 500)))
            || isBranchNotice()
          )
            && movedWindow('notification', 'notifications/' + notificationId))
          // No window: one window admits one notification per batch, and a
          // delete moves several children in one batch. Bounded instead by the
          // real move and the id (one notice per child).
          || isMovedNotice()
        );
      // Recipient may only flip the read flag
      allow update: if verified()
        && resource.data.recipientUid == request.auth.uid
        && changedKeys().hasOnly(['read']);
      allow delete: if verified() && resource.data.recipientUid == request.auth.uid;

      // RL-152: "someone branched your recipe". recipeId names the new branch;
      // the sender must be its author and the recipient the parent's owner, and
      // never the sender (two document reads).
      function isBranchNotice() {
        let d = request.resource.data;
        return request.resource.data.type in ['branch']
          && (d.get('message', null) == null
            || (d.message is string && d.message.size() <= 500))
          && d.recipientUid is string
          && d.recipientUid != request.auth.uid
          && 'recipeId' in d
          && isBranchBy(get(/databases/$(database)/documents/recipes/$(d.recipeId)).data, d.recipientUid);
      }

      // RL-158: "your branch was moved up" after its parent was deleted.
      // recipeId names the moved child and the id is 'moved_' + recipeId + '_'
      // + the deleted version's id (the child's stored parentId, read before the
      // batch), so there is one notice per child per delete (RL-159: one per
      // child ever denied a second move of the same child). The recipient must be the child's
      // author and never the sender, and the child's parentId must change in
      // this same batch, which isReparentAfterParentDelete() limits to the
      // deleted version's owner. message is the sender's text (the client
      // sends the deleted version's title); the rule only caps its length.
      // Accesses: the moved child, once per batch (see the reparent rule).
      function isMovedNotice() {
        let d = request.resource.data;
        return request.resource.data.type in ['moved']
          && d.get('message', null) is string
          && d.message.size() <= 200
          && d.recipientUid is string
          && d.recipientUid != request.auth.uid
          && d.get('recipeId', null) is string
          && notificationId == 'moved_' + d.recipeId + '_' + get(/databases/$(database)/documents/recipes/$(d.recipeId)).data.parentId
          && isMovedChildOf(/databases/$(database)/documents/recipes/$(d.recipeId), d.recipientUid);
      }

      function isMovedChildOf(path, recipientUid) {
        return get(path).data.createdBy.uid == recipientUid
          && getAfter(path).data.get('parentId', null) != get(path).data.get('parentId', null);
      }

      function isBranchBy(branch, recipientUid) {
        return branch.createdBy.uid == request.auth.uid
          && branch.get('parentId', null) is string
          && get(/databases/$(database)/documents/recipes/$(branch.parentId)).data.createdBy.uid == recipientUid;
      }
    }

    // --- Notification preferences: private, one document per account (RL-152) ---
    //
    // "Notify me when" choices. Owner-only read: they are applied when the
    // recipient reads Activity, so writers never read someone else's
    // preferences. updatedAt must be serverTimestamp().
    match /notificationPrefs/{uid} {
      allow read: if verified() && request.auth.uid == uid;
      // signedIn() like termsAcceptance, so erasure works if verification lapses.
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if verified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['branch', 'suggestion', 'follow', 'updatedAt'])
        && request.resource.data.branch is bool
        && request.resource.data.suggestion is bool
        && request.resource.data.follow is bool
        && request.resource.data.updatedAt == request.time;
    }

    // --- Profiles: public read; own doc writable; others may only bump followerCount ---
    //
    // Avatar bound (RL-019). The rules language has no constants, so the literal
    // below must match Avatar.tsx's 'data:image/' check:
    //   MAX_PHOTO_URL_LENGTH = 100000  characters (UTF-16 units; base64 is ASCII)
    // photoURL must be absent, null, or an inline data:image/ URL. A URL hosted by
    // a third party would log the IP and user agent of everyone who views the
    // avatar. The check runs on create and when an update touches photoURL, so an
    // old bad value does not block an unrelated edit such as displayName. The
    // app's 128x128 JPEG is about 4 KB of base64.
    match /profiles/{uid} {
      allow read: if true;
      allow create: if verified() && request.auth.uid == uid
        && photoURLOk();
      allow update: if verified()
        && ((request.auth.uid == uid
              && (!('photoURL' in changedKeys()) || photoURLOk()))
            || isFollowerCountBump());
      allow delete: if verified() && request.auth.uid == uid;

      function photoURLOk() {
        let p = request.resource.data.get('photoURL', null);
        return p == null
          || (p is string && p.matches('^data:image/.*') && p.size() <= 100000);
      }

      function isFollowerCountBump() {
        return changedKeys().hasOnly(['followerCount'])
          && (request.resource.data.followerCount == resource.data.followerCount + 1
              || request.resource.data.followerCount == resource.data.followerCount - 1);
      }
    }

    // --- Terms acceptance: private, one document per account (RL-047) ---
    //
    // Owner-only read: the author decided acceptance is private, so it is not on
    // the public profile. Only the latest acceptance is kept. acceptedAt is the
    // client's clock when the box was ticked, so it is bounded like a recipe's
    // createdAt; recordedAt must be serverTimestamp(). Delete is the owner's, for
    // account erasure (RL-057); a deleted acceptance just blocks contributing again.
    match /termsAcceptance/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if verified()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'acceptedAt', 'recordedAt'])
        && request.resource.data.version == termsVersion()
        && request.resource.data.acceptedAt is int
        && request.resource.data.acceptedAt <= request.time.toMillis() + 60000
        && request.resource.data.recordedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // --- Write windows: per-user fixed-window counters (RL-048, RL-049) ---
    //
    // One document per user per action, id {uid}_{action}, written in the same
    // transaction as the suggestion, message, notification or recipe create it
    // counts (see movedWindow()). Each action has its own cap and window length
    // (capFor(), windowMsFor()); the action is the id after the underscore.
    // `last` is that document's path, relative to the database root.
    // Separate from rateLimits, which stays closed for the Cloud Function.
    //
    // Read is derived from the id alone, never resource.data: the client reads
    // its window before the first write, when the document does not exist, and a
    // rule that dereferences resource.data denies a get of a missing document
    // (RL-026). A uid has no underscore, so the id list below is exact; an id such
    // as {uid}_suggestion_extra or another user's prefix matches nothing.
    //
    // `last` (at most 300 characters) is checked by movedWindow(), not here.
    // Create: count 1, windowStart and at the request time. Update: either a new
    // window (only once server time is past windowStart + window) or the same
    // window with windowStart unchanged and count + 1, up to the cap. The
    // same-window branch has no time check on purpose: the client keeps
    // incrementing for a margin past expiry (RESET_MARGIN_MS) to absorb clock skew,
    // which only ever makes it stricter. Delete would reset the limit, so never.
    match /writeWindows/{windowId} {
      allow read: if signedIn() && windowId in ownWindowIds();
      allow create: if isWindowWrite()
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time;
      allow update: if isWindowWrite()
        && (
          (request.time > resource.data.windowStart + duration.value(windowMsFor(windowAction()), 'ms')
            && request.resource.data.count == 1
            && request.resource.data.windowStart == request.time)
          || (request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= capFor(windowAction()))
        );
      allow delete: if false;

      // A uid has no underscore, so these four ids are exact.
      function ownWindowIds() {
        let u = request.auth.uid;
        return [u + '_suggestion', u + '_reply', u + '_notification', u + '_recipe'];
      }

      // Only meaningful once windowId is in ownWindowIds().
      function windowAction() {
        return windowId.split('_')[1];
      }

      function isWindowWrite() {
        let d = request.resource.data;
        return verified()
          && windowId in ownWindowIds()
          && d.keys().hasOnly(['windowStart', 'count', 'at', 'last'])
          && d.last is string && d.last.size() <= 300
          && d.windowStart is timestamp
          && d.count is int
          && d.at == request.time;
      }
    }

    // --- Client error reports: write-only drop box ---
    //
    // Create-only, by anyone including signed-out visitors, because a failure that
    // happens before or during sign-in is exactly the kind currently invisible.
    // Exempt from the verified-email rule of 2026-10-14 on purpose: this is crash
    // telemetry the app sends on its own, not a user action.
    //
    // No read, ever, from a client. These documents carry stack traces and uids;
    // the only consumer is you, in the console. No update or delete either, so a
    // report cannot be altered after the fact.
    //
    // The field constraints are the abuse control. This is an unauthenticated
    // write path, so it is bounded in shape rather than left open: required keys
    // must be present and correctly typed, nothing outside the known set is
    // accepted, and the two free-text fields are length-capped so the collection
    // cannot be used as free storage. The client caps sends per session as well,
    // but a client-side cap protects Firestore costs from *bugs*, not from people.
    match /clientErrors/{reportId} {
      allow read, update, delete: if false;
      allow create: if isWellFormedReport();

      function isWellFormedReport() {
        let d = request.resource.data;
        return d.keys().hasOnly([
              'source', 'message', 'stack', 'route', 'context',
              'at', 'uid', 'receivedAt', 'userAgent'
            ])
          && d.keys().hasAll(['source', 'message', 'route', 'at'])
          && d.source in ['window.onerror', 'unhandledrejection', 'handled']
          && d.message is string && d.message.size() <= 600
          && d.route is string && d.route.size() <= 250
          && (!('stack' in d.keys()) || d.stack == null || (d.stack is string && d.stack.size() <= 2200))
          && (!('context' in d.keys()) || d.context == null || (d.context is string && d.context.size() <= 150))
          && (!('userAgent' in d.keys()) || (d.userAgent is string && d.userAgent.size() <= 350))
          && d.at is int
          // Either signed out, or stamped with the writer's own uid. Nobody gets
          // to file reports against someone else's account.
          && (!('uid' in d.keys()) || d.uid == null || d.uid == request.auth.uid)
          // The beacon always writes serverTimestamp(), so any other value is free storage on an unauthenticated path.
          && (!('receivedAt' in d.keys()) || d.receivedAt == request.time);
      }
    }

    // --- Rate limits: server-only ---
    // Written exclusively by the generateRecipe Cloud Function via the Admin SDK,
    // which bypasses these rules. Denying everything to clients is what stops a
    // user resetting their own quota, so this must stay closed.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // --- Follows: doc id is {followerId}_{followingId}, controlled by the follower ---
    match /follows/{followId} {
      // `.get` with a default for the same reason `verified()` uses it: this is a
      // disjunction containing a dereference, so on a document missing the field
      // the property form raises an evaluation error where `.get` evaluates false.
      //
      // Emulator-verified 2026-08-11, and the results correct FUN-20's premise
      // rather than confirming it. A `list` never sees document data at all --
      // it is authorised against the query's constraints -- so a malformed
      // document cannot fail a filtered query, and an unfiltered one fails
      // identically with zero malformed documents present. On the `get` path,
      // where document data IS bound, a third party's malformed document is
      // denied under both forms. So this changes no outcome for any query the
      // app issues; it makes the denial read `false` instead of
      // "Property followingId is undefined", which is what sent the last
      // investigation looking for a corrupt document that never existed.
      allow read: if signedIn()
        && (resource.data.get('followerId', '') == request.auth.uid
            || resource.data.get('followingId', '') == request.auth.uid);
      allow create: if verified()
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId;
      allow delete: if verified() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
  }
}
